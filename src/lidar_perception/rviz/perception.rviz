Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Name: Grid
      Plane: XY
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 200; 200; 200
      Color Transformer: Intensity
      Decay Time: 0
      Name: Raw cloud
      Position Transformer: XYZ
      Selectable: true
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /points_raw
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 60; 180; 75
      Color Transformer: FlatColor
      Name: Ground
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_perception/ground
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 245; 130; 48
      Color Transformer: FlatColor
      Name: Nonground
      Position Transformer: XYZ
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar_perception/nonground
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Bounding boxes and tracks
      Namespaces: {}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar_perception/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: lidar
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 35
      Focal Point:
        X: 12
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.55
      Yaw: 3.9
Window Geometry:
  Height: 900
  Width: 1440
